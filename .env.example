# Knight & Ember — inquiry backend configuration.
# The form works without any of these (submissions are logged + written to
# .data/inquiries.jsonl in dev). Set them to turn on real storage + email.

# --- Storage: Supabase (recommended) ---
# Project settings → API. The SERVICE ROLE key is server-only; never expose it
# to the browser. Leave unset to use the local-file fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email: Resend (auto-response + owner notification) ---
# https://resend.com — verify your sending domain, then create an API key.
RESEND_API_KEY=
# Must be an address on your verified domain, e.g. "Knight & Ember <hello@knightandember.com>"
INQUIRY_FROM_EMAIL=
# Where new-inquiry alerts are sent (Andrea's inbox).
INQUIRY_OWNER_EMAIL=

# --- Optional ---
# Booking link included in the auto-response when the lead chooses to schedule
# a consultation (Calendly / Cal.com / Acuity).
CONSULT_BOOKING_URL=
