# Knight & Ember — inquiry backend configuration.
# The form works without any of these (each lead is logged as an
# `[inquiry:lead] {…}` line + written to .data/inquiries.jsonl in dev). Set the
# email vars below to turn on real lead delivery. In production these are
# Cloudflare Worker secrets (`npx wrangler secret put NAME`).

# --- Email capture: Resend (current setup) ---
# https://resend.com — create an API key; verify a sending domain to allow the
# client auto-response (owner alerts work without domain verification).
RESEND_API_KEY=
# The sender. Use an address on your (verified) domain,
# e.g. "Knight & Ember <hello@theandreaknight.com>"
INQUIRY_FROM_EMAIL=
# Where new-inquiry alerts are sent (Andrea's inbox).
INQUIRY_OWNER_EMAIL=
# Optional — booking link added to the confirmation when the visitor opts to
# schedule a consultation (Calendly / Cal.com / Acuity).
CONSULT_BOOKING_URL=

# --- Optional database (only if you want a searchable archive) ---
# store.ts priority: Google Sheets → Supabase → local log. Leave blank to use
# email + logs only.

# Supabase — Project settings → API. SERVICE ROLE key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets — deploy google-apps-script/Code.gs as a Web App (see README).
# NOTE: if these were set on the Worker and Sheets isn't working, delete them.
GOOGLE_SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=
